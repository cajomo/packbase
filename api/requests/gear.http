@baseUrl = http://localhost:8080/api/v1
# Log in first with auth.http (it sets the session cookie and {{xsrf}}).

### List all gear
GET {{baseUrl}}/gear

### Create gear item (all fields)
# @name createGear
POST {{baseUrl}}/gear
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{
  "name": "Titanium spork",
  "category": "Kitchen",
  "weightGrams": 12,
  "quantity": 1,
  "notes": "Ultralight"
}

### Create gear item (required fields only)
POST {{baseUrl}}/gear
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{
  "name": "Tent",
  "category": "Shelter"
}

### Create gear item - invalid (expect 400: empty name, negative weight)
POST {{baseUrl}}/gear
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{
  "name": "",
  "category": "Kitchen",
  "weightGrams": -1
}

### Get by id (uses id from "createGear" above; send that first)
@id = {{createGear.response.body.id}}

GET {{baseUrl}}/gear/{{id}}

### Get by id - not found (expect 404)
GET {{baseUrl}}/gear/00000000-0000-0000-0000-000000000000

### Update gear item
PUT {{baseUrl}}/gear/{{createGear.response.body.id}}
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{
  "name": "Titanium spork (long)",
  "category": "Kitchen",
  "weightGrams": 15,
  "quantity": 2
}

### Delete gear item (expect 204)
DELETE {{baseUrl}}/gear/{{createGear.response.body.id}}
X-XSRF-TOKEN: {{xsrf}}
